# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
MODEL_API_KEY=
SESSION_SECRET=change-me-to-a-long-random-string
AI_PROVIDER=mock
# Verified Standard-mode model id (empty = real calls refused). Example: muse-spark-1.3
META_MODEL=
# Other AI vendors (Phase 1 orchestration). Each needs its own API key AND
# an explicit model id; empty means that vendor is unavailable and the
# router skips it. Consumer chat subscriptions do NOT grant API access.
# Never commit real keys; never print them.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional task routing "kind:provider,..." (unknown pairs ignored).
AI_ROUTES=
BUDGET_MONTHLY_USD=75.0
BUDGET_PER_CONVERSATION_USD=1.0
BUDGET_PER_USER_DAILY_USD=5.0
# Production database (Neon). Empty = local SQLite at DATABASE_PATH.
DATABASE_URL=
DATABASE_PATH=data/mira.db
# Test-suite PostgreSQL target (Neon staging branch). Empty = SQLite files.
# NEVER point this at the production database: tests wipe the mira_test schema.
# Set to the literal word "sqlite" to force SQLite files (ignores this URL).
MIRA_TEST_DATABASE_URL=
# Demo seeding/login override. Keep empty (off). Set to 1 ONLY on an
# isolated demo service with a demo database, never on production.
MIRA_DEMO_MODE=
